{
  "name": "@nimbleoffice/fonts-latin",
  "version": "0.4.2",
  "description": "Latin and Noto RTL faces for @nimbleoffice/fonts, compressed as font pack format 1.",
  "sideEffects": false,
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "assets",
    "LICENSE",
    "LICENSES",
    "README.md"
  ],
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "tsup": "^8.0.1",
    "typescript": "^6.0.3"
  },
  "keywords": [
    "fonts",
    "latin",
    "noto",
    "docx",
    "ooxml"
  ],
  "author": "NimbleOffice",
  "license": "(Apache-2.0 AND OFL-1.1)",
  "repository": {
    "type": "git",
    "url": "https://github.com/Eliseowzy/nimbleoffice.git",
    "directory": "packages/fonts-latin"
  },
  "bugs": {
    "url": "https://github.com/Eliseowzy/nimbleoffice/issues"
  },
  "publishConfig": {
    "access": "public"
  }
}
